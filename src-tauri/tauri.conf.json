{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mad",
  "version": "0.2.3",
  "identifier": "com.john.mad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [
      {
        "title": "mad",
        "width": 1240,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 19,
          "y": 27
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "category": "Productivity",
    "copyright": "© 2026 John Chipps-Harding. MIT licensed."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2QURERDZFQjFDQkExRDgKUldUWW9jdXhidDJ0eG1TRjZOUDBQa0U2aFhKTFhiL2VsMEdJOSsvMUFmbnVUZkh5WDRxSE95eWsK",
      "endpoints": [
        "https://github.com/digitaljohn/mad/releases/latest/download/latest.json"
      ]
    }
  }
}
